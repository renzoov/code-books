---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import BackLink from '../../../components/BackLink.astro';
import BookCover from '../../../components/BookCover.astro';
import BookCard from '../../../components/BookCard.astro';
import { books, booksOf, techBySlug, techHref, pageOf, getInsight, authorsText, ENFOQUE_LABEL } from '../../../lib/data';

export const getStaticPaths = (() =>
  books.map((book) => ({ params: { tech: book.techSlug, slug: book.slug }, props: { book } }))) satisfies GetStaticPaths;

const { book } = Astro.props;
const tech = techBySlug(book.techSlug);
const insight = await getInsight(book.slug, book.techSlug);
const page = pageOf(book);

const related = booksOf(book.techSlug)
  .filter((b) => b.slug !== book.slug && b.nivel === book.nivel)
  .slice(0, 2);

const practico = insight ? { teorico: 10, ejercicios: 55, proyectos: 80, mixto: 70 }[insight.enfoque] : 0;
---

<Layout title={book.titulo} accent={tech.color} activeTech={tech.slug}>
  <BackLink href={techHref(tech.slug, page)}>← Volver a {tech.nombre} (página {page})</BackLink>

  <article class="mt-6 grid gap-10 md:grid-cols-[16rem_1fr]" data-detail-book={`${book.techSlug}-${book.slug}`}>
    <div>
      <BookCover book={book} width={512} class="w-full max-w-64" morph />
    </div>

    <div class="min-w-0">
      <h1 class="text-3xl font-bold leading-tight sm:text-4xl">
        {book.titulo}
      </h1>
      <p class="mt-2 text-lg text-muted">{authorsText(book)}</p>

      <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line font-mono text-sm sm:grid-cols-4">
        {
          [
            ['Editorial', book.editorial ?? 'n/d'],
            ['Año', book.anio ?? 'n/d'],
            ['Páginas', book.paginas ? `~${book.paginas}` : 'n/d'],
            ['Nivel', book.nivel ?? 'n/d'],
          ].map(([k, v]) => (
            <div class="bg-panel p-3">
              <dt class="text-xs text-muted">{k}</dt>
              <dd class="mt-1 truncate" title={String(v)}>{v}</dd>
            </div>
          ))
        }
      </dl>

      {
        insight ? (
          <>
            <section class="mt-8">
              <h2 class="mb-3 text-xl font-bold">De qué trata</h2>
              <div class="space-y-3 leading-relaxed text-[#c9cdd8]">
                {insight.descripcion.split('\n\n').map((p) => <p>{p}</p>)}
              </div>
              {insight.confianza === 'media' && (
                <p class="mt-3 font-mono text-xs text-muted">Descripción aproximada: se basa en el título y el contexto del libro.</p>
              )}
              <ul class="mt-4 flex flex-wrap gap-1.5 font-mono text-xs">
                {insight.temas.map((t) => <li class="rounded-full border border-line px-2.5 py-1">{t}</li>)}
              </ul>
            </section>

            <section class="mt-8 rounded-xl border border-line bg-panel p-5">
              <h2 class="mb-4 text-xl font-bold">¿Cómo enseña?</h2>
              <div class="font-mono text-xs text-muted">
                <div class="mb-1 flex justify-between"><span>Teórico</span><span>Práctico</span></div>
                <div class="h-2 rounded bg-line">
                  <div class="h-2 rounded bg-[var(--accent)]" style={`width:${practico}%`} />
                </div>
                <p class="mt-2 text-sm text-white">{ENFOQUE_LABEL[insight.enfoque]}</p>
              </div>
              <ul class="mt-4 space-y-1 text-sm">
                <li>{insight.tieneEjercicios ? '✓ Incluye ejercicios' : '✗ Sin ejercicios'}</li>
                <li>{insight.tieneProyectos ? '✓ Incluye proyectos' : '✗ Sin proyectos'}</li>
              </ul>
              {insight.proyectos.length > 0 && (
                <div class="mt-4 space-y-3 border-t border-line pt-4">
                  <h3 class="font-mono text-xs uppercase tracking-widest text-muted">Proyectos</h3>
                  {insight.proyectos.map((p) => (
                    <div>
                      <p class="font-bold">{p.nombre}</p>
                      <p class="text-sm text-[#c9cdd8]">{p.descripcion}</p>
                    </div>
                  ))}
                </div>
              )}
            </section>
          </>
        ) : (
          <p class="mt-8 rounded-xl border border-dashed border-line p-5 font-mono text-sm text-muted">
            Descripción en preparación.
          </p>
        )
      }
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="mt-14">
        <h2 class="mb-4 text-xl font-bold">Más de {tech.nombre} con nivel {book.nivel}</h2>
        <div class="grid gap-4 lg:grid-cols-2">{related.map((b) => <BookCard book={b} />)}</div>
      </section>
    )
  }
</Layout>
