---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import BackLink from '../../components/BackLink.astro';
import BookCard from '../../components/BookCard.astro';
import Pagination from '../../components/Pagination.astro';
import { techs, booksOf, techBySlug, categoryOf, categoryHref, getCover, PAGE_SIZE } from '../../lib/data';

export const getStaticPaths = (({ paginate }) =>
  techs.flatMap((t) =>
    paginate(booksOf(t.slug), { params: { tech: t.slug }, pageSize: PAGE_SIZE }),
  )) satisfies GetStaticPaths;

const { page } = Astro.props;
const tech = techBySlug(Astro.params.tech!);
const category = categoryOf(tech);

// Portadas de la página siguiente (mismo ancho que BookCard, así es el mismo archivo): se precargan con
// prioridad baja mientras se mira esta página para que al pasar de página las tarjetas aparezcan completas.
// Lo hace el script de abajo, que se salta la precarga en modo ahorro de datos o con conexión lenta.
const nextCovers = (
  await Promise.all(
    booksOf(tech.slug)
      .slice(page.end + 1, page.end + 1 + PAGE_SIZE)
      .map(async (b) => {
        const cover = await getCover(b.slug);
        return cover && (await getImage({ src: cover, width: 160 })).src;
      }),
  )
).filter(Boolean);
---

<Layout title={`${tech.nombre} · página ${page.currentPage}`} accent={tech.color} activeTech={tech.slug}>
  <header class="mb-8">
    <nav aria-label="Ruta" class="mb-4">
      <BackLink href={categoryHref(category)}>← {category.nombre}</BackLink>
    </nav>
    <p class="font-mono text-xs uppercase tracking-widest text-[var(--accent)]">Sección</p>
    <h1 class="w-fit text-4xl font-bold sm:text-5xl" data-morph-tech={tech.slug}>{tech.nombre}</h1>
    <p class="mt-2 font-mono text-sm text-muted">
      Mostrando {page.start + 1}–{page.end + 1} de {page.total} libros
    </p>
  </header>

  <div class="grid gap-4 lg:grid-cols-2">
    {page.data.map((b) => <BookCard book={b} />)}
  </div>

  <Pagination techSlug={tech.slug} current={page.currentPage} last={page.lastPage} />
  <div hidden data-next-covers={JSON.stringify(nextCovers)}></div>
</Layout>

<script>
  // Espera a que carguen las portadas visibles de esta página (máximo 4 s) para no quitarles conexión.
  const visibleCoversLoaded = () => {
    const pending = [...document.querySelectorAll<HTMLImageElement>('a[data-book] img')].filter(
      (img) => !img.complete && img.getBoundingClientRect().top < innerHeight,
    );
    const loaded = pending.map(
      (img) =>
        new Promise((done) => {
          img.addEventListener('load', done, { once: true });
          img.addEventListener('error', done, { once: true });
        }),
    );
    return Promise.race([Promise.all(loaded), new Promise((done) => setTimeout(done, 4000))]);
  };

  document.addEventListener('astro:page-load', async () => {
    const list = document.querySelector<HTMLElement>('[data-next-covers]');
    if (!list) return;
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    if (conn?.saveData || /2g|3g/.test(conn?.effectiveType ?? '')) return;
    await visibleCoversLoaded();
    if (!list.isConnected) return; // ya se navegó a otra página
    for (const src of JSON.parse(list.dataset.nextCovers!) as string[]) {
      const link = document.createElement('link');
      link.rel = 'prefetch';
      link.as = 'image';
      link.href = src;
      document.head.append(link);
    }
  });
</script>
