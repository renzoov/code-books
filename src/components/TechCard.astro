---
import TechLogo from './TechLogo.astro';
import { techHref, type Tech } from '../lib/data';

interface Props {
  tech: Tech;
}
const { tech: t } = Astro.props;
// Las tecnologías con muchos libros ocupan una tarjeta doble en la grilla bento.
const big = t.total > 100;
---

<a
  href={techHref(t.slug)}
  class:list={[
    'group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-line bg-panel p-5 transition hover:-translate-y-0.5',
    big && 'sm:col-span-2 sm:row-span-2',
  ]}
  style={`--c:${t.color}`}
>
  <div class="absolute -right-10 -top-10 size-40 rounded-full opacity-20 blur-2xl transition group-hover:opacity-40" style="background:var(--c)"></div>
  <TechLogo
    tech={t.slug}
    class:list={[
      'pointer-events-none absolute -bottom-6 -right-6 rotate-[-12deg] opacity-[0.07] transition duration-500 group-hover:rotate-0 group-hover:opacity-[0.12]',
      big ? 'size-28 sm:size-56' : 'size-28',
    ]}
    style="color:var(--c)"
    aria-hidden="true"
  />
  <div class="relative flex items-start justify-between gap-3">
    <span
      class:list={[
        'grid place-items-center rounded-xl border border-line bg-ink/60 shadow-inner',
        big ? 'size-11 p-2 sm:size-16 sm:p-3' : 'size-11 p-2',
      ]}
      style="color:var(--c)"
    >
      <TechLogo tech={t.slug} class="size-full" />
    </span>
    <span class="font-mono text-xs text-muted">{t.total} libros</span>
  </div>
  <span
    class:list={['relative line-clamp-2 w-fit font-bold leading-tight', big ? 'text-2xl sm:text-4xl' : 'text-2xl']}
    title={t.nombre}
    style="color:var(--c)"
    data-morph-tech={t.slug}
  >
    {t.nombre}
  </span>
</a>
