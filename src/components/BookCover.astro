---
import { Image, getImage } from 'astro:assets';
import { getCover, techBySlug, type Book } from '../lib/data';
import placeholders from '../data/cover-placeholders.json';

interface Props {
  book: Book;
  width?: number;
  class?: string;
  /** Portada principal de la página de detalle: siempre participa del morph. */
  morph?: boolean;
}
const { book, width = 240, class: className = '', morph = false } = Astro.props;
const cover = await getCover(book.slug);
const color = techBySlug(book.techSlug).color;
/** Debe coincidir con el ancho de BookCard.astro: el detalle reutiliza esa miniatura ya cacheada. */
const CARD_WIDTH = 160;
// En el detalle la imagen grande es otro archivo y aún no está en caché al llegar desde la lista: mientras
// carga se muestra de fondo la miniatura de la tarjeta, así la portada nunca se ve vacía durante el morph.
const placeholder = morph && cover ? (await getImage({ src: cover, width: CARD_WIDTH })).src : undefined;
// Miniatura borrosa de ~300 bytes incrustada en el HTML (scripts/cover-placeholders.mjs): la portada se ve al
// instante aunque la imagen real tarde en llegar del CDN.
const blur = cover ? (placeholders as Record<string, { src: string }>)[book.slug]?.src : undefined;
const background = [placeholder, blur].map((src) => src && `url(${src})`).filter(Boolean).join(', ');
// En las tarjetas el nombre de transición se asigna por JS solo al libro que se abre o al que se vuelve
// (ver Layout.astro); si todas lo tuvieran, cada portada se animaría por separado del resto de su tarjeta.
const morphProps = morph ? {} : { 'data-morph': 'cover' };
const style =
  [morph && `view-transition-name: cover-${book.techSlug}-${book.slug}`, background && `background-image: ${background}`]
    .filter(Boolean)
    .join('; ') || undefined;
---

<div
  class:list={[
    'relative aspect-[3/4] overflow-hidden rounded-md shadow-lg shadow-black/40',
    cover && 'cover-skeleton',
    className,
  ]}
  {...morphProps}
  style={style}
>
  {
    cover ? (
      <Image
        src={cover}
        alt={`Portada de ${book.titulo}`}
        width={width}
        class="size-full object-cover"
        loading={morph ? 'eager' : 'lazy'}
        fetchpriority={morph ? 'high' : 'auto'}
      />
    ) : (
      <div
        class="flex size-full flex-col justify-between p-3"
        style={`background: linear-gradient(145deg, ${color}, color-mix(in srgb, ${color} 25%, #0b0d12)); `}
        role="img"
        aria-label={`Portada generada de ${book.titulo}`}
      >
        <span class="font-mono text-[10px] uppercase tracking-widest text-black/60">{book.tecnologia}</span>
        <span class="line-clamp-5 text-balance text-base font-bold leading-tight text-black/85">{book.titulo}</span>
        <span class="truncate font-mono text-[10px] text-black/60">{book.autores[0] ?? book.editorial}</span>
      </div>
    )
  }
</div>
