---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import TechNav from '../components/TechNav.astro';
import SearchPalette from '../components/SearchPalette.astro';

interface Props {
  title?: string;
  description?: string;
  accent?: string;
  activeTech?: string;
}

const {
  title = 'CodeBooks',
  description = 'Catálogo informativo de libros de programación: qué enseña cada uno, su nivel y si trae ejercicios o proyectos.',
  accent = '#818cf8',
  activeTech,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title === 'CodeBooks' ? title : `${title} · CodeBooks`}</title>
    <ClientRouter />
    <script>
      // Los morph se activan solo para el elemento involucrado en cada navegación. Si todas las tarjetas
      // tuvieran nombre fijo, cada portada se animaría por separado de su tarjeta al paginar.
      const setMorph = (root: Document, key?: string) => {
        root.querySelectorAll<HTMLElement>('[data-morph]').forEach((el) => (el.style.viewTransitionName = ''));
        if (!key) return;
        const card = root.querySelector(`a[data-book="${CSS.escape(key)}"]`);
        card?.querySelectorAll<HTMLElement>('[data-morph]').forEach((el) => {
          el.style.viewTransitionName = `${el.dataset.morph}-${key}`;
        });
      };
      const setTechMorph = (root: Document, tech?: string) => {
        root.querySelectorAll<HTMLElement>('[data-morph-tech]').forEach((el) => {
          el.style.viewTransitionName = el.dataset.morphTech === tech ? `tech-${tech}` : '';
        });
      };

      // Skeleton de portada: se apaga cuando su imagen carga o falla. "load" no burbujea, por eso se escucha en
      // captura; las que ya estaban en caché antes de que corra este script se marcan en cada carga de página.
      const markCover = (img: EventTarget | null) => {
        if (img instanceof HTMLImageElement) img.parentElement?.closest('.cover-skeleton')?.classList.add('is-loaded');
      };
      document.addEventListener('load', (ev) => markCover(ev.target), true);
      document.addEventListener(
        'error',
        (ev) => {
          // Si la imagen falla queda la miniatura borrosa en vez del ícono de imagen rota.
          if (ev.target instanceof HTMLImageElement && ev.target.closest('.cover-skeleton')) ev.target.style.visibility = 'hidden';
          markCover(ev.target);
        },
        true,
      );
      document.addEventListener('astro:page-load', () => {
        document.querySelectorAll<HTMLImageElement>('.cover-skeleton > img').forEach((img) => img.complete && markCover(img));
      });

      // Durante la animación entre páginas (~0,5 s) Chrome dirige todos los clics al <html>, así que un clic
      // justo al llegar a una página no hacía nada. Ese clic termina la animación y se reenvía al elemento que
      // quedó bajo el puntero (con las mismas teclas, para que Ctrl+clic siga abriendo otra pestaña).
      let runningTransition: ViewTransition | undefined;
      document.addEventListener('astro:before-swap', (ev) => {
        const vt = (runningTransition = ev.viewTransition);
        vt.finished.finally(() => runningTransition === vt && (runningTransition = undefined));
      });
      document.addEventListener(
        'click',
        (ev) => {
          if (!runningTransition || ev.target !== document.documentElement || !ev.isTrusted) return;
          ev.stopImmediatePropagation();
          ev.preventDefault();
          runningTransition.skipTransition();
          requestAnimationFrame(() => {
            const el = document.elementFromPoint(ev.clientX, ev.clientY);
            if (el && el !== document.documentElement) el.dispatchEvent(new MouseEvent('click', ev));
          });
        },
        true,
      );

      let pendingTech: string | undefined;

      document.addEventListener('astro:before-preparation', (ev) => {
        const link = (ev.sourceElement as HTMLElement | undefined)?.closest?.('a');
        // "Volver" y "página anterior" son navegaciones nuevas, pero visualmente van hacia atrás.
        if (link?.dataset.direction === 'back') ev.direction = 'back';
        setMorph(document, link?.dataset.book); // lista → detalle
        // inicio → sección: el nombre de la tarjeta vuela hasta el título de la sección
        pendingTech = link?.querySelector<HTMLElement>('[data-morph-tech]')?.dataset.morphTech;
        setTechMorph(document, pendingTech);
      });

      document.addEventListener('astro:before-swap', (ev) => {
        // detalle → lista (enlace "Volver" o botón atrás del navegador)
        const key = document.querySelector<HTMLElement>('[data-detail-book]')?.dataset.detailBook;
        if (key) setMorph(ev.newDocument, key);
        setTechMorph(ev.newDocument, pendingTech);
        pendingTech = undefined;
      });
    </script>
  </head>
  <body style={`--accent: ${accent}`}>
    <header class="sticky top-0 z-20 border-b border-line bg-ink/80 backdrop-blur" transition:name="site-header" transition:animate="none">
      <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3">
        <a href="/" class="font-mono text-sm font-medium tracking-tight">
          <span class="text-[var(--accent)]">&lt;/&gt;</span> CodeBooks
        </a>
        <TechNav active={activeTech} />
        <SearchPalette />
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-10">
      <slot />
    </main>
    <footer class="mx-auto max-w-6xl border-t border-line px-4 py-8 font-mono text-xs text-muted">
      Catálogo informativo. Sin venta ni descarga de libros.
    </footer>
  </body>
</html>
